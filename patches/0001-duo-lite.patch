+	// Two independently sized compositions, sharing a timeline and one sound cue.
+	class PanelSplash
+	{
+	public:
+		bool load(const std::string& dir, const std::string& banana, const std::string& variant, int w, int h, int topWidth = 0)
+		{
+			panel[1].onCue = [this](const std::string& n) { if (onCue) onCue(n); };
+			return panel[0].load(dir, banana, variant, topWidth > 0 ? topWidth : w, h) && panel[1].load(dir, banana, variant, w, h);
+		}
+		void draw(uint32_t* top, uint32_t* bot, double t, bool ready) { panel[0].draw(top, nullptr, t, ready); panel[1].draw(nullptr, bot, t, ready); }
+		void drawOutro(uint32_t* top, uint32_t* bot, double t) { panel[0].drawOutro(top, nullptr, t); panel[1].drawOutro(nullptr, bot, t); }
+		bool finished(double t, bool ready) const { return panel[1].finished(t, ready); }
+		bool played() const { return panel[1].played(); }
+		int nextFrame(double t, bool ready) const { return panel[1].nextFrame(t, ready); }
+		std::function<void(const std::string&)> onCue;
+	private:
+		Splash panel[2];
+	};
 }
