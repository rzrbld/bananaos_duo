+	bool Library::moveHome(int from, int to)
+	{
+		if (from < 0 || to < 0 || from >= systemCount() || to >= systemCount() || shelves[from].search || shelves[to].search) return false;
+		if (from == to) return true;
+		// Store stable IDs, never indices: installing/removing an app must not move another tile.
+		auto order = homeOrder;
+		std::vector<std::string> visible;
+		for (const auto& sh : shelves) if (!sh.search) visible.push_back(sh.def.id);
+		std::string id = shelves[from].def.id, target = shelves[to].def.id;
+		visible.erase(std::find(visible.begin(), visible.end(), id));
+		auto at = std::find(visible.begin(), visible.end(), target);
+		if (from < to) ++at;
+		visible.insert(at, id);
+		// Retain entries for temporarily absent apps/ROM shelves too.
+		homeOrder = visible;
+		for (const auto& old : order) if (std::find(homeOrder.begin(), homeOrder.end(), old) == homeOrder.end()) homeOrder.push_back(old);
+		saveHomeLayout(); arrangeHome(); return true;
+	}
+
+	void Library::arrangeHome()
+	{
+		std::vector<std::string> old;
+		for (const auto& sh : shelves) old.push_back(sh.def.id);
+		auto group = [this](const Shelf& sh) {
+			if (sh.search) return -1;
+			if (sh.favorites) return 2;
+			return sh.def.appTile || lookOf(sh.def.id).app || sh.def.run.compare(0,7,"banana:")==0 ? 1 : 0;
+		};
+		auto rank = [this](const Shelf& sh) {
+			auto it = std::find(homeOrder.begin(), homeOrder.end(), sh.def.id);
+			return it == homeOrder.end() ? (int)homeOrder.size() : (int)(it-homeOrder.begin());
+		};
+		std::stable_sort(shelves.begin(), shelves.end(), [&](const Shelf& a, const Shelf& b) {
+			if (a.search != b.search) return a.search;
+			int ra = rank(a), rb = rank(b);
+			if (ra != rb) return ra < rb;
+			int ga = group(a), gb = group(b);
+			return ga != gb ? ga < gb : a.order < b.order;
+		});
+		std::vector<int> remap(old.size());
+		for (int i=0; i<systemCount(); ++i) remap[std::find(old.begin(), old.end(), shelves[i].def.id)-old.begin()] = i;
+		for (auto& sh : shelves) if (sh.favorites) for (int& s : sh.sysOf) s = remap[s];
 	}
 
