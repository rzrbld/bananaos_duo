 			int x = 0, y = 0;
 			bool down = false, wasDown = false, moved = false;
@@ -56,7 +56,7 @@
 			int stickMid[2] = { 0, 0 }, stickHalf[2] = { 1, 1 }, stickDir[2] = { 0, 0 };
