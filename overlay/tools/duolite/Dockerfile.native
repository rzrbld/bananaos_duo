FROM banana-duolite-builder:bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential bc bison flex libssl-dev libelf-dev unzip rsync cpio \
        python3-dev swig libgnutls28-dev file wget curl xz-utils bzip2 patch \
        perl texinfo time gawk libncurses-dev \
    && rm -rf /var/lib/apt/lists/* \
    && (getent passwd 1000 || useradd --uid 1000 --create-home banana-builder)
ENV FORCE_UNSAFE_CONFIGURE=1
# Linux's EFI zboot packaging invokes hexdump even when the SD image uses Image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bsdextrautils \
    && rm -rf /var/lib/apt/lists/*
