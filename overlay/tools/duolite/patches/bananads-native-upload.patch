+        // Native GPU fitting uploads these sources; they are never scanned out.
+        // Write-combined DRM mappings are very slow when GL reads them back.
+        // Keep CPU rendering/upload sources cached, retaining GEM only for the
+        // plane-test metadata. Fitted destination buffers remain DRM-backed.
+        if (gpu_fit) {
+            for (auto& panel : buf) for (auto& b : panel) {
