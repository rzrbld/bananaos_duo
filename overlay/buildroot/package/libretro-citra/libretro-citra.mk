LIBRETRO_CITRA_VERSION = a0483e9abe8134ae6b290cdca7d49cb77689f05b
LIBRETRO_CITRA_SITE = https://github.com/libretro/citra.git
LIBRETRO_CITRA_SITE_METHOD = git
LIBRETRO_CITRA_GIT_SUBMODULES = YES
LIBRETRO_CITRA_SUPPORTS_IN_SOURCE_BUILD = NO
LIBRETRO_CITRA_LICENSE = GPL-2.0-or-later
LIBRETRO_CITRA_LICENSE_FILES = license.txt
LIBRETRO_CITRA_DEPENDENCIES = sdl2 zlib boost libegl libgles
LIBRETRO_CITRA_CONF_OPTS = -DCMAKE_NO_SYSTEM_FROM_IMPORTED=ON -DBUILD_SHARED_LIBS=OFF \
	-DENABLE_LIBRETRO=ON \
	-DENABLE_SDL2=OFF \
	-DENABLE_QT=OFF \
	-DENABLE_QT_UPDATER=OFF \
	-DENABLE_TESTS=OFF \
	-DENABLE_DEDICATED_ROOM=OFF \
	-DENABLE_WEB_SERVICE=OFF \
	-DENABLE_SCRIPTING=OFF \
	-DENABLE_CUBEB=OFF \
	-DENABLE_OPENAL=OFF \
	-DENABLE_LIBUSB=OFF \
	-DENABLE_COMPATIBILITY_LIST_DOWNLOAD=OFF \
	-DUSE_DISCORD_PRESENCE=OFF \
	-DCITRA_ENABLE_BUNDLE_TARGET=OFF \
	-DCITRA_WARNINGS_AS_ERRORS=OFF \
	-DENABLE_LTO=OFF \
	-DUSING_GLES=ON \
	-DENABLE_OPT=OFF \
	-DCMAKE_POLICY_VERSION_MINIMUM=3.5

define LIBRETRO_CITRA_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0644 $(LIBRETRO_CITRA_BUILDDIR)/citra_libretro.so $(TARGET_DIR)/usr/lib/libretro/citra_libretro.so
endef

$(eval $(cmake-package))
