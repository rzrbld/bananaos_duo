 	  This is a driver for the Qualcomm Network-on-Chip on sm6115-based
 	  platforms.
 
+config INTERCONNECT_QCOM_SM6125
+	tristate "Qualcomm SM6125 interconnect driver"
+	depends on INTERCONNECT_QCOM
+	depends on QCOM_SMD_RPM
+	depends on ARM64 || COMPILE_TEST
+	select INTERCONNECT_QCOM_SMD_RPM
+	help
+	  This is a driver for the Qualcomm Network-on-Chip on sm6125-based
+	  platforms. It provides the bimc, cnoc and snoc fabrics along with
+	  the virtual providers used for multimedia and GPU traffic, and lets
+	  consumers scale bus bandwidth at runtime. Say Y or M here if you
+	  want to support interconnect scaling on SM6125 devices.
+
 config INTERCONNECT_QCOM_SM6350
 	tristate "Qualcomm SM6350 interconnect driver"
 	depends on INTERCONNECT_QCOM_RPMH_POSSIBLE
