+/* No I2C here: memless callbacks run under the input event spinlock. */
+static void aw86927_set_level(struct aw86927_data *haptics, bool gamepad, u16 level)
+{
+	unsigned long flags;
+	u16 combined;
+
+	spin_lock_irqsave(&haptics->control_lock, flags);
+	if (!haptics->rumble_enabled || haptics->suspended)
+		level = 0;
+	if (gamepad)
+		haptics->gamepad_level = level;
+	else
+		haptics->direct_level = level;
+	combined = max(haptics->direct_level, haptics->gamepad_level);
+	if (haptics->level != combined) {
+		WRITE_ONCE(haptics->level, combined);
+		schedule_work(&haptics->play_work);
+	}
+	spin_unlock_irqrestore(&haptics->control_lock, flags);
+}
+
+int aw86927_rumble(struct device *dev, u16 strong, u16 weak)
+{
+	struct aw86927_data *haptics = dev_get_drvdata(dev);
+
+	if (!haptics || !READ_ONCE(haptics->ready))
+		return -EPROBE_DEFER;
+	aw86927_set_level(haptics, true, max(strong, weak));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(aw86927_rumble);
