+static ssize_t rumble_enabled_store(struct device *dev, struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct aw86927_data *haptics = dev_get_drvdata(dev);
+	unsigned long flags;
+	bool enabled;
+	int err = kstrtobool(buf, &enabled);
+
+	if (err)
+		return err;
+	spin_lock_irqsave(&haptics->control_lock, flags);
+	haptics->rumble_enabled = enabled;
+	if (!enabled) {
+		haptics->direct_level = haptics->gamepad_level = 0;
+		WRITE_ONCE(haptics->level, 0);
+		schedule_work(&haptics->play_work);
+	}
+	spin_unlock_irqrestore(&haptics->control_lock, flags);
+	if (!enabled)
+		flush_work(&haptics->play_work);
+	return count;
+}
+static DEVICE_ATTR_RW(rumble_enabled);
