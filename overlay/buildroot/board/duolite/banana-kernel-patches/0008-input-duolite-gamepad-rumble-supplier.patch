+static int rsinput_play_rumble(struct input_dev *input, void *data, struct ff_effect *effect)
+{
+    struct rsinput_driver *drv = input_get_drvdata(input);
+
+    return drv->play_rumble(drv->haptics, effect->u.rumble.strong_magnitude,
+                            effect->u.rumble.weak_magnitude);
+}
+
+static void rsinput_release_haptics(void *data)
+{
+    struct rsinput_driver *drv = data;
+
+    drv->play_rumble(drv->haptics, 0, 0);
+    symbol_put(aw86927_rumble);
+    put_device(drv->haptics);
+}
+
+static int rsinput_setup_haptics(struct rsinput_driver *drv, struct device *dev)
+{
+    struct device_node *node;
+    struct i2c_client *client;
+    int err;
+
+    node = of_parse_phandle(dev->of_node, "banana,haptics", 0);
+    if (!node)
+        return 0;
+    client = of_find_i2c_device_by_node(node);
+    of_node_put(node);
+    if (!client)
+        return -EPROBE_DEFER;
+    drv->haptics = &client->dev;
+    drv->play_rumble = symbol_request(aw86927_rumble);
+    if (!drv->play_rumble) {
+        put_device(drv->haptics);
+        return -EPROBE_DEFER;
+    }
+    err = devm_add_action_or_reset(dev, rsinput_release_haptics, drv);
+    if (err)
+        return err;
+    err = drv->play_rumble(drv->haptics, 0, 0);
+    if (err)
+        return err;
+    if (!device_link_add(dev, drv->haptics, DL_FLAG_AUTOREMOVE_CONSUMER))
+        return -ENOMEM;
+    return 0;
+}
+
