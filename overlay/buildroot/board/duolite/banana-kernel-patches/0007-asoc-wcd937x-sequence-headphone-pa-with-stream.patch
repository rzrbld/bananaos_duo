+/* Keep the headphone PA inside the enabled SoundWire stream window.
+ * DAPM may power down after hw_free, when its data clocks are already gone. */
+static int wcd937x_codec_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct wcd937x_priv *wcd937x = dev_get_drvdata(dai->dev);
+	struct snd_soc_component *component = dai->component;
+	bool left, right;
+
+	if (stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+
+	left = !mute && wcd937x->hphl_enable;
+	right = !mute && wcd937x->hphr_enable;
+	if (left != wcd937x->hphl_pa_enabled) {
+		wcd937x_codec_enable_hphl_pa(component, left);
+		wcd937x->hphl_pa_enabled = left;
+	}
+	if (right != wcd937x->hphr_pa_enabled) {
+		wcd937x_codec_enable_hphr_pa(component, right);
+		wcd937x->hphr_pa_enabled = right;
+	}
+
+	return 0;
+}
