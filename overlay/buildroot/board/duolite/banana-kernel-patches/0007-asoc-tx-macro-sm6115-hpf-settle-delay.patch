Subject: [PATCH] ASoC: lpass-tx-macro: allow SM6115 HPF transitions to settle

Test the one-clock settling interval used by the downstream Bolero filter
sequence on the SM6115 TX macro. Keep newer macro variants unchanged.

--- a/sound/soc/codecs/lpass-tx-macro.c
+++ b/sound/soc/codecs/lpass-tx-macro.c
@@ -700,6 +700,9 @@
 					      CDC_TXn_HPF_F_CHANGE_MASK |
 					      CDC_TXn_HPF_ZERO_GATE_MASK,
 					      0x02);
+		/* Bolero v1.0 needs a filter clock before the gate transition. */
+		if (tx->data->ver == LPASS_VER_10_0_0)
+			usleep_range(1000, 1010);
 		snd_soc_component_update_bits(component, hpf_gate_reg,
 					      CDC_TXn_HPF_F_CHANGE_MASK |
 					      CDC_TXn_HPF_ZERO_GATE_MASK,
@@ -990,6 +993,8 @@
 						      CDC_TXn_HPF_F_CHANGE_MASK |
 						      CDC_TXn_HPF_ZERO_GATE_MASK,
 						      0x00);
+			if (tx->data->ver == LPASS_VER_10_0_0)
+				usleep_range(1000, 1010);
 			snd_soc_component_update_bits(component, hpf_gate_reg,
 					      CDC_TXn_HPF_F_CHANGE_MASK |
 					      CDC_TXn_HPF_ZERO_GATE_MASK,
