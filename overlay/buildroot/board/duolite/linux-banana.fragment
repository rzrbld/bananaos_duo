CONFIG_LOCALVERSION="-banana-duolite"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEFAULT_HOSTNAME="banana"
CONFIG_EFI_STUB=y
CONFIG_EFI_ARMSTUB_DTB_LOADER=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_DRM_MSM_KMS_FBDEV is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_RUST is not set
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
# Native SMB file sharing uses the same userspace tools as upstream BananaLinux.
CONFIG_SMB_SERVER=m
# SM6125 Venus 5.4 has its own video clock/power controller.
CONFIG_SM_VIDEOCC_6125=m
CONFIG_INTERCONNECT_QCOM_SM6125=m
