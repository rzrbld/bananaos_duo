+/* The stdin callback only queues work. Core operations run after retro_run has
+ * returned, so reset/load cannot reenter a core's input callback. Replies use
+ * the stdin transport's stdout, independent of driver reinitialization. */
+#ifdef HAVE_KMS
+void gfx_ctx_drm_banana_menu(bool active);
+#endif
+static int banana_menu_pending;
+static int banana_menu_slot;
+enum { BM_CMD_INFO = 1, BM_CMD_PAUSE, BM_CMD_RESUME, BM_CMD_SAVE,
+       BM_CMD_LOAD, BM_CMD_RESET, BM_CMD_ADVANCED, BM_CMD_QUIT, BM_CMD_NOSAVE };
+
+bool command_banana_menu(command_t *cmd, const char *arg)
+{
+#if defined(HAVE_STDIN_CMD)
+   int op = 0, slot = 0;
+   if (cmd->replier != stdin_command_reply || banana_menu_pending)
+      return false;
+   if (!strcmp(arg, "INFO")) op = BM_CMD_INFO;
+   else if (!strcmp(arg, "PAUSE")) op = BM_CMD_PAUSE;
+   else if (!strcmp(arg, "RESUME")) op = BM_CMD_RESUME;
+   else if (!strcmp(arg, "RESET")) op = BM_CMD_RESET;
+   else if (!strcmp(arg, "ADVANCED")) op = BM_CMD_ADVANCED;
+   else if (!strcmp(arg, "QUIT")) op = BM_CMD_QUIT;
+   else if (!strcmp(arg, "QUIT_NOSAVE")) op = BM_CMD_NOSAVE;
+   else if (!strncmp(arg, "SAVE ", 5) || !strncmp(arg, "LOAD ", 5))
+   {
+      op = arg[0] == 'S' ? BM_CMD_SAVE : BM_CMD_LOAD;
+      slot = atoi(arg + 5);
+      if (slot < -1 || slot > 9) return false;
+   }
+   if (!op) return false;
+   banana_menu_slot = slot;
+   banana_menu_pending = op;
+   return true;
+#else
+   return false;
+#endif
+}
+
+void command_banana_menu_iterate(void)
+{
+   char path[PATH_MAX_LENGTH] = "";
+   const int op = banana_menu_pending, slot = banana_menu_slot;
+   const char *name = "UNKNOWN";
+   bool ok = true;
+   if (!op) return;
+   banana_menu_pending = 0;
+   if (op == BM_CMD_INFO)
+   {
+      runloop_get_savestate_path(path, sizeof(path), 0);
+      fprintf(stdout, "BANANA_MENU INFO %d\t%s\n",
+            config_get_ptr()->bools.savestate_auto_save ? 1 : 0, path);
+      fflush(stdout);
+      return;
+   }
+   switch (op)
+   {
+      case BM_CMD_PAUSE:
+         name = "PAUSE";
+#ifdef HAVE_KMS
+         gfx_ctx_drm_banana_menu(true);
+#endif
+#ifdef HAVE_MENU
+         if (menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE)
+            command_event(CMD_EVENT_MENU_TOGGLE, NULL);
+#endif
+         command_event(CMD_EVENT_PAUSE, NULL);
+         ok = (runloop_state_get_ptr()->flags & RUNLOOP_FLAG_PAUSED) != 0;
+         break;
+      case BM_CMD_RESUME:
+         name = "RESUME";
+#ifdef HAVE_KMS
+         gfx_ctx_drm_banana_menu(false);
+#endif
+         command_event(CMD_EVENT_UNPAUSE, NULL);
+         break;
+      case BM_CMD_RESET:
+         name = "RESET";
+         command_event(CMD_EVENT_UNPAUSE, NULL);
+         command_event(CMD_EVENT_RESET, NULL);
+         break;
+      case BM_CMD_ADVANCED:
+         name = "ADVANCED";
+#ifdef HAVE_KMS
+         gfx_ctx_drm_banana_menu(false);
+#endif
+         command_event(CMD_EVENT_UNPAUSE, NULL);
+         command_event(CMD_EVENT_MENU_TOGGLE, NULL);
+         break;
+      case BM_CMD_SAVE:
+      case BM_CMD_LOAD:
+         name = op == BM_CMD_SAVE ? "SAVE" : "LOAD";
+         ok = core_info_current_supports_savestate();
+#ifdef HAVE_CHEEVOS
+         if (rcheevos_hardcore_active()) ok = false;
+#endif
+         if (!ok) break;
+         runloop_get_savestate_path(path, sizeof(path), slot);
+         if (op == BM_CMD_SAVE)
+         {
+            ok = content_save_state(path, true);
+            content_wait_for_save_state_task();
+            ok = ok && path_is_valid(path);
+         }
+         else
+         {
+            ok = content_load_state(path, false, false);
+            content_wait_for_load_state_task();
+            if (ok) command_post_state_loaded();
+         }
+         break;
+      case BM_CMD_QUIT:
+      case BM_CMD_NOSAVE:
+         name = "QUIT";
+         if (op == BM_CMD_NOSAVE)
+            config_get_ptr()->bools.savestate_auto_save = false;
+         command_event(CMD_EVENT_QUIT, NULL);
+         break;
+   }
+   fprintf(stdout, "BANANA_MENU %s %s\n", name, ok ? "OK" : "ERR");
+   fflush(stdout);
 }
 
