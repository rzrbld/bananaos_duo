From: BananaOS Duo Lite port
Subject: [PATCH] SDL panels: single rotated landscape panel for native ports

--- a/src/video/dummy/SDL_bananapanels.c
+++ b/src/video/dummy/SDL_bananapanels.c
@@ -39,7 +39,7 @@
     int front;
 } BP_Panel;
 
-static int bp_fd = -1, bp_on, bp_side, bp_pending, bp_W, bp_H;
+static int bp_fd = -1, bp_on, bp_side, bp_pending, bp_W, bp_H, bp_single, bp_rotation;
 static BP_Panel bp_p[2];   /* 0 the top panel, 1 the bottom one */
 
 static int bp_ioctl(unsigned long req, void *arg)
@@ -130,6 +130,9 @@
     int i, found = 0;
     if (!how || !*how) return -1;
     bp_side = SDL_strcmp(how, "stack") != 0;
+    bp_single = SDL_strcmp(how, "top") == 0;
+    bp_rotation = bp_single && SDL_getenv("SDL_BANANA_TOP_ROTATION") ? SDL_atoi(SDL_getenv("SDL_BANANA_TOP_ROTATION")) : 0;
+    if (bp_rotation != 90 && bp_rotation != 270) bp_rotation = 0;
     if (!topname || !*topname) topname = "DSI-2";
     bp_fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
     if (bp_fd < 0) return SDL_SetError("SDL_BANANA_PANELS: /dev/dri/card0: %s", strerror(errno));
@@ -167,6 +170,7 @@
     }
     bp_W = bp_side ? (int)(bp_p[0].w + bp_p[1].w) : (int)SDL_max(bp_p[0].w, bp_p[1].w);
     bp_H = bp_side ? (int)SDL_max(bp_p[0].h, bp_p[1].h) : (int)(bp_p[0].h + bp_p[1].h);
+    if (bp_single) { bp_W = bp_rotation ? (int)bp_p[0].h : (int)bp_p[0].w; bp_H = bp_rotation ? (int)bp_p[0].w : (int)bp_p[0].h; }
     *w = bp_W; *h = bp_H;
     bp_on = 1;
     return 0;
@@ -203,13 +207,43 @@
     }
 }
 
+int BP_read_bgra = 0;
+
+/* Single landscape panel, preserving a game's aspect ratio and native scanout. */
+static void bp_single_pixels(BP_Panel *pn, int back, const void *pixels, int pitch, int w, int h, int gl)
+{
+    int vw = bp_rotation ? (int)pn->h : (int)pn->w;
+    int vh = bp_rotation ? (int)pn->w : (int)pn->h;
+    int fw = vw, fh = (int)((long long)vw*h/w), left, top, x, y;
+    if (fh > vh) { fh = vh; fw = (int)((long long)vh*w/h); }
+    if (fw < 1) fw = 1;
+    if (fh < 1) fh = 1;
+    left = (vw-fw)/2; top = (vh-fh)/2;
+    for (y=0; y<(int)pn->h; y++) {
+        Uint32 *dst = (Uint32 *)(pn->buf[back].map+(size_t)y*pn->buf[back].pitch);
+        for (x=0; x<(int)pn->w; x++) {
+            int rx = bp_rotation == 270 ? (int)pn->h-1-y : bp_rotation == 90 ? y : x;
+            int ry = bp_rotation == 270 ? x : bp_rotation == 90 ? (int)pn->w-1-x : y;
+            Uint32 pixel = 0;
+            rx-=left; ry-=top;
+            if (rx>=0 && ry>=0 && rx<fw && ry<fh) {
+                int sx=(int)((long long)rx*w/fw), sy=(int)((long long)ry*h/fh);
+                if (gl) sy=h-1-sy;
+                pixel=*(const Uint32 *)((const Uint8 *)pixels+(size_t)sy*pitch+(size_t)sx*4);
+                if (gl && !BP_read_bgra) pixel=(pixel & 0xff00ff00u) | ((pixel & 255u)<<16) | ((pixel>>16)&255u);
+            }
+            dst[x]=pixel;
+        }
+    }
+}
+
 /* one frame of the window (XRGB8888, w x h) onto the panels: each into its hidden buffer, then flipped */
 int BP_Present(const void *pixels, int pitch, int w, int h)
 {
     int s;
     if (!bp_on) return 0;
     bp_wait_flips();
-    for (s = 0; s < 2; s++) {
+    for (s = 0; s < (bp_single ? 1 : 2); s++) {
         BP_Panel *pn = &bp_p[s];
         int back = pn->front ^ 1, x0, y0, y, rows, cols;
         struct drm_mode_crtc_page_flip pf;
@@ -217,7 +251,8 @@
         rows = SDL_min((int)pn->h, h - y0);
         cols = SDL_min((int)pn->w, w - x0);
         if (rows <= 0 || cols <= 0) continue;
-        for (y = 0; y < rows; y++)
+        if (bp_single) bp_single_pixels(pn, back, pixels, pitch, w, h, 0);
+        else for (y = 0; y < rows; y++)
             SDL_memcpy(pn->buf[back].map + (size_t)y * pn->buf[back].pitch,
                        (const Uint8 *)pixels + (size_t)(y0 + y) * pitch + (size_t)x0 * 4, (size_t)cols * 4);
         SDL_zero(pf);
@@ -229,13 +264,13 @@
 }
 
 /* the same from a GL read-back: RGBA, the last row first */
-int BP_read_bgra = 0;   /* the read-back is already in the panels' order (GL_BGRA_EXT) */
+
