+        /* Scale in the panel's visible orientation; the scanout stays native. */
+        const char *rotation = i == 0 ? getenv("DK_TOP_ROTATION") : NULL;
+        p->rotation = rotation ? atoi(rotation) : 0;
+        if (p->rotation != 90 && p->rotation != 270) p->rotation = 0;
+        int vw = p->rotation ? p->h : p->w, vh = p->rotation ? p->w : p->h;
+        p->scale = MAX(1, MIN(vw / 320, vh / 240));
+        p->lw = vw / p->scale; p->lh = vh / p->scale;
+        p->ox = (vw - p->lw * p->scale) / 2; p->oy = (vh - p->lh * p->scale) / 2;
         for (int k = 0; k < 2; k++) if (mkbuf(&p->b[k], (uint32_t)p->w, (uint32_t)p->h)) {
             plat_log("kms: dumb buffer alloc failed"); drmDropMaster(fd); close(fd); fd = -1; return -1;
         }
@@ -304,6 +308,19 @@
  * (the dumb buffer is write-combined: only ever write it, in long runs) */
 static void upscale(Panel *p, Buf *b, const Surf *s) {
     int k = p->scale, w = MIN(s->w, p->lw), h = MIN(s->h, p->lh);
+    if (p->rotation) {
+        /* Contiguous WC writes, with the same clockwise convention as Banana UI. */
+        for (int y = 0; y < p->h; y++) {
+            int rx = (p->rotation == 270 ? p->h - 1 - y : y) - p->ox;
+            for (int x = 0; x < p->w; x++) {
+                int ry = (p->rotation == 270 ? x : p->w - 1 - x) - p->oy;
+                rowbuf[x] = rx >= 0 && ry >= 0 && rx < w*k && ry < h*k
+                    ? s->px[(size_t)(ry/k)*s->pitch + rx/k] : 0;
+            }
+            memcpy((uint8_t *)b->map + (size_t)y*b->pitch, rowbuf, (size_t)p->w*4);
+        }
+        return;
+    }
     for (int y = 0; y < h; y++) {
         const uint32_t *src = s->px + (size_t)y * s->pitch;
         uint32_t *r = rowbuf;
